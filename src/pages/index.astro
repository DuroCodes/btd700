---
import "../styles/global.css";

const title = "BTD 700";
const description = "Browser controls for the Sennheiser BTD 700 dongle.";
const base = Astro.site ?? Astro.url;
const url = new URL(Astro.url.pathname, base).href;
const image = new URL("/og.png", base).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="BTD 700, browser controls for the Sennheiser dongle"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <main>
      <header>
        <div>
          <h1>BTD 700</h1>
          <p id="status">Connect the dongle.</p>
          <p id="link-state" hidden></p>
          <p id="firmware" hidden></p>
        </div>
        <button id="connect" type="button">Connect</button>
        <button id="disconnect" type="button" hidden>Disconnect</button>
      </header>

      <section id="controls" hidden>
        <div class="modes" role="group" aria-label="Audio link">
          <button type="button" data-mode="0">Standard</button>
          <button type="button" data-mode="1">Gaming</button>
          <button type="button" data-mode="2">Broadcast</button>
        </div>

        <div id="link-properties" class="fields">
          <div class="field">
            <span>Audio quality</span>
            <span id="audio-quality">—</span>
          </div>
          <label class="field">
            <span>Transport</span>
            <select id="transport">
              <option value="1">BT Classic</option>
              <option value="2">LE Audio</option>
              <option value="3">Multipoint</option>
            </select>
          </label>
          <label class="field">
            <span>Codec</span>
            <select id="codec"></select>
          </label>
        </div>

        <div id="broadcast-properties" class="fields" hidden>
          <label class="field">
            <span>Audio quality</span>
            <select id="broadcast-quality">
              <option value="2">High quality, 48 kHz</option>
              <option value="1">Standard, 24 kHz</option>
              <option value="0">Standard, 16 kHz</option>
            </select>
          </label>
          <label class="field">
            <span>Name</span>
            <input
              id="broadcast-name"
              type="text"
              maxlength="32"
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <label class="field">
            <span>Audience</span>
            <select id="broadcast-audience">
              <option value="1">Public</option>
              <option value="0">Private</option>
            </select>
          </label>
          <label class="field">
            <span>Password</span>
            <input
              id="broadcast-password"
              type="text"
              maxlength="16"
              autocomplete="off"
              spellcheck="false"
              placeholder="None"
            />
          </label>
          <div class="field action">
            <span>Encryption follows the password.</span>
            <button id="save-broadcast" type="button">Save</button>
          </div>
        </div>

        <p id="result"></p>
      </section>

      <details>
        <summary>Log</summary>
        <p id="device"></p>
        <pre id="log"></pre>
      </details>
    </main>
  </body>
</html>

<script>
  import { start } from "../scripts/panel";
  start();
</script>
